{
  "name": "yuan-dao",
  "version": "1.1.0",
  "private": true,
  "description": "闻道 MindSpeak 英语学习软件（Web + PWA + Android + 桌面版）",
  "scripts": {
    "build": "node build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/browser-smoke.mjs",
    "desktop:pack": "node scripts/desktop-pack.js",
    "desktop:build": "npm run build && npm run desktop:pack && tauri build",
    "desktop:dev": "node server/server.js & tauri dev",
    "android:build": "npm run build && npx cap sync android",
    "android:release": "npm run build && npx cap sync android",
    "android:dev": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-navigation-bar": "^8.2.6",
    "@sentiolabs/opencode-frontend-design": "^0.3.0",
    "@tauri-apps/cli": "^2.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "terser": "^5.49.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
