# 敏感凭据（163 邮箱 SMTP 授权码等）——绝不提交
server/.env

# 依赖与构建产物
node_modules/
dist/
coverage/

# 运行时数据库（含用户数据，启动时自动重建）
server/data/

# 运行日志
server/logs/

# 本机代理工具
server/cloudflared.exe

# 系统文件
Thumbs.db
.DS_Store

# 安卓签名密钥（安全：只存 GitHub Secrets，勿提交）
*.keystore
*.jks
*.p12
mindspeak-keystore.p12

# Tauri 桌面版构建产物
src-tauri/target/
src-tauri/gen/
src-tauri/resources/
src-tauri/node-runtime/
*.msi
*.exe
*.app
*.dmg
*.AppImage

# Android rebuild（android/ 由 npx cap add android 自动生成，不入库）。
# 必须锚定根目录：裸 android/ 会连 tests/android/ 一起忽略
/android/
*.apk
*.jks
*.keystore
!android-template/

# 开发辅助产物（技能/浏览器调试截图与临时备份）
.superpowers/
.workbuddy/
browser-shots/
test-screenshots/
# UI 审计产物：scripts/ui-audit.mjs 每次运行会产出 audit-shots/（约 6.4MB，80 张截图），
# 并把上一轮备份成 audit-shots.bak-<UTC 时间戳>/（保留最近 1 份）。这些都是可再生的
# 检查证据，不是源码，别把它们当提交产物。
audit-shots/
audit-shots.bak-*/
# 审查过程中手工截取的证据图（docs/ui-review-*.md 的配图除外）
docs/review-shots-*/
*.bak
*draft-backup.js

# 调试脚本输出截图（mobile-shot.mjs 等的产物，非源码）。
# 不能用裸 *.png：assets/pwa/ 与 src-tauri/icons/ 下 27 个图标是合法源码，
# 裸规则会让将来新增图标必须 git add -f 强推。
scripts/*.png