# 敏感凭据（163 邮箱 SMTP 授权码等）——绝不提交
server/.env

# 依赖与构建产物
node_modules/
dist/

# 运行时数据库（含用户数据，启动时自动重建）
server/data/

# 运行日志
server/logs/

# 本机代理工具
server/cloudflared.exe

# 系统文件
Thumbs.db
.DS_Store

# 安卓签名密钥（安全：只存 GitHub Secrets，勿提交）
*.keystore
*.jks
*.p12
mindspeak-keystore.p12

# Tauri 桌面版构建产物
src-tauri/target/
src-tauri/gen/
src-tauri/resources/
src-tauri/node-runtime/
*.msi
*.exe
*.app
*.dmg
*.AppImage

# Android rebuild（android/ 由 npx cap add android 自动生成，不入库）
android/
*.jks
*.keystore
!android-template/